{
  "title": "{{ book_title }}",
  "languages": {
    "available": [
      {% for lang in languages %}"{{ lang }}"{% if not loop.last %}, {% endif %}{% endfor %}
    ],
    "default": "{{ default_language }}"
  },
  "features": {
    "signLanguage": {{ features['signLanguage'] | tojson }},
    "easyRead": {{ features['easyRead'] | tojson }},
    "glossary": {{ features['glossary'] | tojson }},
    "eli5": {{ features['eli5'] | tojson }},
    "readAloud": {{ features['readAloud'] | tojson }},
    "autoplay": {{ features['autoplay'] | tojson }},
    "showTutorial": {{ features['showTutorial'] | tojson }},
    "showNavigationControls": {{ features['showNavigationControls'] | tojson }},
    "describeImages": {{ features['describeImages'] | tojson }},
    "notepad": {{ features['notepad'] | tojson }},
    "state": {{ features['state'] | tojson }},
    "characterDisplay": {{ features['characterDisplay'] | tojson }},
    "highlight": {{ features['highlight'] | tojson }},
    "activities": {{ features['activities'] | tojson }}
  },
  "analytics": {
    "enabled": false,
    "siteId": 0,
    "trackerUrl": "https://unisitetracker.unicef.io/matomo.php",
    "srcUrl": "https://unisitetracker.unicef.io/matomo.js"
  }
}