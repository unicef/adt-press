{
  "title": "{{ book_title }}",
  "languages": {
    "available": [
      {% for lang in languages %}"{{ lang }}"{% if not loop.last %}, {% endif %}{% endfor %}
    ],
    "default": "{{ default_language }}"
  },
  "features": {
    "signLanguage": false,
    "easyRead": {{ feature_overrides.get('easyRead', (config.easy_read_strategy != 'none')) | tojson }},
    "glossary": {{ feature_overrides.get('glossary', (config.glossary_strategy != 'none')) | tojson }},
    "eli5": {{ feature_overrides.get('eli5', (config.explanation_strategy != 'none')) | tojson }},
    "readAloud": {{ feature_overrides.get('readAloud', (config.speech_strategy != 'none')) | tojson }},
    "autoplay": true,
    "showTutorial": {{ feature_overrides.get('showTutorial', true) | tojson }},
    "showNavigationControls": {{ feature_overrides.get('showNavigationControls', true) | tojson }},
    "describeImages": true,
    "notepad": false,
    "state": true,
    "characterDisplay": true,
    "highlight": false
  },
  "analytics": {
    "enabled": false,
    "siteId": 0,
    "trackerUrl": "https://unisitetracker.unicef.io/matomo.php",
    "srcUrl": "https://unisitetracker.unicef.io/matomo.js"
  }
}